---
import type { Locale } from '../data/content';
import { presentations } from '../data/content';
import { t } from '../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const tr = t(lang);

// 저자 문자열에서 본인 이름만 굵게 (국문 논문은 한글 이름)
const meOf = (authors: string) => (authors.includes('왕성필') ? '왕성필' : 'Sungpil Wang');
---

<section id="presentations">
  <div class="wrap">
    <div class="reveal">
      <span class="eyebrow">{tr('eyebrow.presentations')}</span>
      <h2 class="section-title">{tr('section.presentations')}</h2>
      <p class="section-sub">{tr('section.presentations.sub')}</p>
    </div>
    <ol class="list">
      {presentations.map((p, i) => (
        <li class="row reveal" style={`transition-delay:${i * 50}ms`}>
          <div class="term">{p.term}</div>
          <div class="body">
            <span class="badge">{p.kind[lang]}</span>
            <p class="title">{p.title}</p>
            <p class="authors">
              {p.authors.split(meOf(p.authors)).map((part, j) => (
                <>{j > 0 && <strong>{meOf(p.authors)}</strong>}{part}</>
              ))}
            </p>
            <p class="venue">{p.venue}</p>
            {p.ledTo && (
              <a class="led" href={p.ledTo.href} target="_blank" rel="noopener">→ {p.ledTo.label[lang]}</a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .list { list-style: none; display: flex; flex-direction: column; }
  .row {
    display: grid;
    grid-template-columns: 168px 1fr;
    gap: 28px;
    align-items: baseline;
    padding: 22px 0;
    border-top: 1px solid var(--border);
  }
  .row:first-child { border-top: none; }
  .term {
    color: var(--accent);
    font-weight: 650;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
  }
  .badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    background: var(--surface);
    margin-bottom: 8px;
  }
  .title {
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }
  .authors {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 3px;
  }
  .authors strong { color: var(--fg, inherit); font-weight: 650; }
  .venue {
    color: var(--muted);
    font-size: 0.9rem;
    font-style: italic;
    margin-top: 2px;
  }

  .led {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: 6px;
  }
  .led:hover { text-decoration: underline; }

  @media (max-width: 620px) {
    .row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
