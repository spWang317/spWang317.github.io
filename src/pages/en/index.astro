---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Research from '../../components/Research.astro';
import Publications from '../../components/Publications.astro';
import { publications } from '../../data/content';
import Presentations from '../../components/Presentations.astro';
import Books from '../../components/Books.astro';
import Projects from '../../components/Projects.astro';
import Awards from '../../components/Awards.astro';
import Teaching from '../../components/Teaching.astro';
import Education from '../../components/Education.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const lang = 'en' as const;
---

<Base lang={lang}>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Research lang={lang} />
    {publications.length > 0 && <Publications lang={lang} />}
    <Presentations lang={lang} />
    <Books lang={lang} />
    <Projects lang={lang} />
    <Awards lang={lang} />
    <Teaching lang={lang} />
    <Education lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
